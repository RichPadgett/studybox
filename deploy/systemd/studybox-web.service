[Unit]
Description=StudyBox Web UI
After=network-online.target studybox-api.service
Wants=network-online.target
Requires=studybox-api.service

[Service]
Type=simple
User=studybox
Group=studybox
WorkingDirectory=/opt/studybox
Environment=NODE_ENV=development
EnvironmentFile=-/etc/studybox/studybox.env
ExecStart=/usr/bin/npm run dev -w @studybox/web -- --host 0.0.0.0 --port 5173
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
