[Unit]
Description=StudyBox API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=studybox
Group=studybox
WorkingDirectory=/opt/studybox
Environment=NODE_ENV=production
Environment=PORT=4000
EnvironmentFile=-/etc/studybox/studybox.env
ExecStart=/usr/bin/npm run start -w @studybox/api
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
