# Keep secrets only in /etc/studybox/studybox.env on the Pi.
# ChatGPT subscriptions and OpenAI API billing are separate.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_ANALYSIS_MODEL=gpt-5-mini

# Local AI transcript library. Keep this on the SSD mount when one is installed.
STUDYBOX_LIBRARY_DIR=/var/lib/studybox/library
STUDYBOX_TRANSCRIPT_CHUNK_SECONDS=600
# Temporary access point used when no saved Wi-Fi network connects during boot.
# STUDYBOX_WIFI_INTERFACE=wlan0
# STUDYBOX_SETUP_SSID=StudyBox-Setup
# STUDYBOX_SETUP_PASSWORD=StudyBoxSetup!26
# STUDYBOX_SETUP_ADDRESS=10.42.0.1/24
# STUDYBOX_WIFI_FALLBACK_WAIT_SECONDS=75
# Optional explicit path if ffmpeg is not in the service PATH.
# STUDYBOX_FFMPEG_PATH=/usr/bin/ffmpeg
