# Keep secrets only in /etc/studybox/studybox.env on the Pi.
# ChatGPT subscriptions and OpenAI API billing are separate.
OPENAI_API_KEY=
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-transcribe
OPENAI_ANALYSIS_MODEL=gpt-5-mini

# Zoom SDK raw recording currently conflicts with the independent DJI capture
# on the Pi. Keep it off until Zoom video uses a separate archive path.
STUDYBOX_ZOOM_LOCAL_RECORDING_ENABLED=false
# Cloud MP4s are downloaded temporarily, verified in S3, then removed locally.
STUDYBOX_S3_KEEP_LOCAL_ZOOM=false
STUDYBOX_ZOOM_MATCH_WINDOW_MINUTES=180
STUDYBOX_ZOOM_CLOUD_QUEUE_PATH=/var/lib/studybox/zoom-cloud/queue.json
STUDYBOX_ZOOM_CLOUD_DOWNLOAD_DIR=/var/lib/studybox/zoom-cloud/downloads
# The API supervises the native Zoom agent independently of the dashboard.
# Active intent survives a service restart for up to 12 hours; an intentional
# Zoom stop clears it before ending the meeting.
STUDYBOX_ZOOM_SUPERVISOR_INTERVAL_MS=3000
STUDYBOX_ZOOM_RECONNECT_GRACE_MS=30000
STUDYBOX_ZOOM_RECONNECT_MAX_DELAY_MS=60000
# Brief runner timeouts remain graceful reconnecting states. Red/error is only
# shown after repeated idle checks or exhausted active-meeting recovery.
STUDYBOX_ZOOM_SYNC_FAILURES_BEFORE_ERROR=4
STUDYBOX_ZOOM_RECONNECT_TERMINAL_ATTEMPTS=5
STUDYBOX_ZOOM_INTENT_MAX_AGE_MS=43200000
# STUDYBOX_MEETING_INTENT_PATH=/var/lib/studybox/meeting-intent.json
# Persists all one- or two-part recordings until local backup bundles exist.
# STUDYBOX_SESSION_WRAPUP_PATH=/var/lib/studybox/session-wrapup.json

# Local AI transcript library. Keep this on the SSD mount when one is installed.
STUDYBOX_LIBRARY_DIR=/var/lib/studybox/library
STUDYBOX_TRANSCRIPT_CHUNK_SECONDS=600
# A recording pause at least this long starts a new lesson part on resume.
STUDYBOX_RECORDING_PART_PAUSE_SECONDS=300
# Temporary access point used when no saved Wi-Fi network connects during boot.
# STUDYBOX_WIFI_INTERFACE=wlan0
# STUDYBOX_SETUP_SSID=StudyBox-Setup
# STUDYBOX_SETUP_PASSWORD=StudyBoxSetup!26
# STUDYBOX_SETUP_ADDRESS=10.42.0.1/24
# STUDYBOX_WIFI_FALLBACK_WAIT_SECONDS=75
# Optional explicit path if ffmpeg is not in the service PATH.
# STUDYBOX_FFMPEG_PATH=/usr/bin/ffmpeg

# Dedicated physical controls. All switch grounds may be daisy-chained.
STUDYBOX_PAGE_BUTTON_GPIO=17
STUDYBOX_ZOOM_BUTTON_GPIO=6
STUDYBOX_RECORDING_BUTTON_GPIO=5
STUDYBOX_BUTTON_LONG_PRESS_MS=2200

# Common-anode RGB button channels. Use low-side drivers if the button current
# exceeds the Pi GPIO rating; set STUDYBOX_RGB_ACTIVE_LOW=false for common-cathode hardware.
STUDYBOX_RGB_ACTIVE_LOW=true
STUDYBOX_REC_RGB_R_GPIO=12
STUDYBOX_REC_RGB_G_GPIO=13
STUDYBOX_REC_RGB_B_GPIO=16
STUDYBOX_ZOOM_RGB_R_GPIO=19
STUDYBOX_ZOOM_RGB_G_GPIO=20
STUDYBOX_ZOOM_RGB_B_GPIO=21
