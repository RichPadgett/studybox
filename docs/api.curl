# StudyBox API curl requests
# Base URL: http://localhost:4000

curl --request GET 'http://localhost:4000/api/snapshot'

curl --request POST 'http://localhost:4000/api/admin/login' \
  --header 'Content-Type: application/json' \
  --data '{
    "pin": "364364"
  }'

# Copy the login response token into protected requests:
# --header 'Authorization: Bearer paste-admin-token'

# Zoom readiness and SDK auth helpers.

curl --request GET 'http://localhost:4000/api/zoom/status'

curl --request POST 'http://localhost:4000/api/zoom/sdk-jwt' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/zoom/device-authorization' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/zoom/device-token' \
  --header 'Authorization: Bearer paste-admin-token' \
  --header 'Content-Type: application/json' \
  --data '{
    "deviceCode": "paste-device-code-from-device-authorization-response"
  }'

curl --request POST 'http://localhost:4000/api/zoom/refresh-token' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request GET 'http://localhost:4000/api/zoom/zak/status' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/zoom/webhooks' \
  --header 'Content-Type: application/json' \
  --data '{
    "event": "endpoint.url_validation",
    "event_ts": 1785690000000,
    "payload": {
      "plainToken": "local-validation-test"
    }
  }'

# Appliance controls.

curl --request POST 'http://localhost:4000/api/buttons/page' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/buttons/action' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/meeting/start' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/meeting/end' \
  --header 'Authorization: Bearer paste-admin-token'

# In runner mode, mock runner participant IDs are runner-w1 and runner-p2.

curl --request POST 'http://localhost:4000/api/meeting/waiting/w1/admit' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/meeting/raised-hands/p3/dismiss' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/meeting/raised-hands/p3/allow' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/meeting/participants/p3/podcast-inclusion' \
  --header 'Authorization: Bearer paste-admin-token' \
  --header 'Content-Type: application/json' \
  --data '{
    "included": true
  }'

curl --request POST 'http://localhost:4000/api/meeting/participants/p3/mute' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/meeting/waiting/runner-w1/admit' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/meeting/raised-hands/runner-p2/dismiss' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/meeting/raised-hands/runner-p2/allow' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/meeting/participants/runner-p2/podcast-inclusion' \
  --header 'Authorization: Bearer paste-admin-token' \
  --header 'Content-Type: application/json' \
  --data '{
    "included": true
  }'

curl --request POST 'http://localhost:4000/api/meeting/participants/runner-p2/mute' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/audio/teacher-input' \
  --header 'Authorization: Bearer paste-admin-token' \
  --header 'Content-Type: application/json' \
  --data '{
    "deviceId": "dji-receiver"
  }'

curl --request POST 'http://localhost:4000/api/audio/audience-input' \
  --header 'Authorization: Bearer paste-admin-token' \
  --header 'Content-Type: application/json' \
  --data '{
    "deviceId": "conference-speakerphone-mic"
  }'

curl --request POST 'http://localhost:4000/api/audio/speaker-output' \
  --header 'Authorization: Bearer paste-admin-token' \
  --header 'Content-Type: application/json' \
  --data '{
    "deviceId": "conference-speakerphone-output"
  }'

curl --request POST 'http://localhost:4000/api/podcast/start' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/podcast/pause' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/podcast/resume' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request POST 'http://localhost:4000/api/podcast/stop' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request GET 'http://localhost:4000/api/podcast/recordings/rec-001/download' \
  --header 'Authorization: Bearer paste-admin-token' \
  --output bible-study-YYYY-MM-DD-HH-MM.wav

curl --request POST 'http://localhost:4000/api/backup/sync' \
  --header 'Authorization: Bearer paste-admin-token'

curl --request PUT 'http://localhost:4000/api/settings' \
  --header 'Authorization: Bearer paste-admin-token' \
  --header 'Content-Type: application/json' \
  --data '{
    "schedule": {
      "dayOfWeek": "Saturday",
      "time": "11:00",
      "timezone": "America/New_York",
      "autoStartMeeting": true,
      "autoStartRecording": true
    },
    "moderation": {
      "mode": "moderated",
      "joinMuted": true,
      "raiseHandRequired": true,
      "assistantApprovesSpeakers": true,
      "includeApprovedRemoteSpeakersInPodcast": false
    },
    "zoom": {
      "meetingNumber": "123456789",
      "displayName": "StudyBox",
      "clientIdConfigured": true,
      "sdkSecretConfigured": true,
      "webhookSecretConfigured": true,
      "redirectUri": "https://studybox.enochscalendar.com/zoom/oauth/callback",
      "deviceOAuthEnabled": true
    },
    "audio": {
      "inputDevice": "DJI Mic Receiver (Mock)",
      "gain": 70,
      "monitorEnabled": false
    },
    "wifi": {
      "ssid": "StudyBox-WiFi",
      "configured": true
    },
    "cloudflare": {
      "tunnelEnabled": false,
      "hostname": ""
    },
    "oled": {
      "brightness": 80,
      "rotate180": false
    }
  }'
