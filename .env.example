ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://studybox.enochscalendar.com/zoom/oauth/callback
ZOOM_ACCOUNT_ID=
ZOOM_WEBHOOK_SECRET_TOKEN=

# The real Meeting SDK process will run on the Raspberry Pi ARM64 target.
ZOOM_MEETING_MODE=mock
ZOOM_SDK_ARCH=linux-arm64
ZOOM_RUNNER_PATH=./native/zoom-runner/build/studybox-zoom-runner
ZOOM_RUNNER_COMMAND=node
ZOOM_RUNNER_ARGS=./native/zoom-runner-mock/dist/index.js
