ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://studybox.enochscalendar.com/zoom/oauth/callback
ZOOM_ACCOUNT_ID=
ZOOM_WEBHOOK_SECRET_TOKEN=

# The real Meeting SDK process will run on the Raspberry Pi ARM64 target.
ZOOM_MEETING_MODE=mock
ZOOM_SDK_ARCH=linux-arm64
ZOOM_RUNNER_PATH=./native/zoom-runner/build/studybox-zoom-runner

# Mock runner process mode, useful for protocol testing:
ZOOM_RUNNER_COMMAND=node
ZOOM_RUNNER_ARGS=./native/zoom-runner-mock/dist/index.js

# Native runner process mode, used on the Pi once the C++ runner is built:
# ZOOM_MEETING_MODE=runner
# ZOOM_RUNNER_COMMAND=./native/zoom-runner/build/studybox-zoom-runner
# ZOOM_RUNNER_ARGS=

STUDYBOX_ADMIN_PIN=364364

# Hardware mode. Use mock for local development; use raspberryPi on the appliance.
STUDYBOX_HARDWARE_MODE=mock

# Waveshare 2.42 inch OLED Module, SSD1309, 4-wire SPI.
# Header wiring:
# RST -> GPIO27 pin 13, DC -> GPIO25 pin 22, CS -> GPIO8 pin 24,
# CLK -> GPIO11 pin 23, DIN -> GPIO10 pin 19, GND -> pin 6, VCC -> pin 1.
STUDYBOX_OLED_SPI_DEVICE=/dev/spidev0.0
STUDYBOX_GPIO_CHIP=gpiochip4
STUDYBOX_OLED_DC_GPIO=25
STUDYBOX_OLED_RST_GPIO=27

# Physical PAGE/ACTION buttons. Leave mock until the buttons are wired.
# Default wiring assumes each button connects its GPIO to GND when pressed.
STUDYBOX_BUTTON_MODE=mock
STUDYBOX_PAGE_BUTTON_GPIO=17
STUDYBOX_ACTION_BUTTON_GPIO=6
STUDYBOX_BUTTON_EDGE=falling
STUDYBOX_BUTTON_BIAS=pull-up
STUDYBOX_BUTTON_DEBOUNCE_MS=250

# Dedicated recording LED. Default wiring:
# GPIO23 / physical pin 16 -> resistor -> LED positive, LED negative -> GND.
STUDYBOX_LED_MODE=mock
STUDYBOX_REC_LED_GPIO=23
STUDYBOX_REC_LED_ACTIVE_LOW=false

# Backup sync starts in mock mode. Real Pi mode should use rsync over SSH.
STUDYBOX_BACKUP_MODE=mock
STUDYBOX_BACKUP_REPO=hetzner:studybox-backup
STUDYBOX_BACKUP_QUEUE_PATH=./data/backup-queue.json
STUDYBOX_BACKUP_DIR=./data/backup-bundles
STUDYBOX_BACKUP_HOST=178.156.141.174
STUDYBOX_BACKUP_USER=deploy
STUDYBOX_BACKUP_REMOTE_DIR=/srv/studybox-backups
STUDYBOX_BACKUP_SSH_KEY=/var/lib/studybox/.ssh/studybox_backup
STUDYBOX_BACKUP_PORT=22
STUDYBOX_BACKUP_RETRY_SECONDS=300
