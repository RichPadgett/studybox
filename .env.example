ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://studybox.enochscalendar.com/zoom/oauth/callback
ZOOM_ACCOUNT_ID=
ZOOM_WEBHOOK_SECRET_TOKEN=

# The real Meeting SDK process will run on the Raspberry Pi ARM64 target.
ZOOM_MEETING_MODE=mock
ZOOM_SDK_ARCH=linux-arm64
ZOOM_RUNNER_PATH=./native/zoom-runner/build/studybox-zoom-runner
ZOOM_RUNNER_COMMAND=node
ZOOM_RUNNER_ARGS=./native/zoom-runner-mock/dist/index.js

STUDYBOX_ADMIN_PIN=364364

# Backup sync starts in mock mode. Real Pi mode should use rsync over SSH.
STUDYBOX_BACKUP_MODE=mock
STUDYBOX_BACKUP_REPO=hetzner:studybox-backup
STUDYBOX_BACKUP_QUEUE_PATH=./data/backup-queue.json
STUDYBOX_BACKUP_DIR=./data/backup-bundles
STUDYBOX_BACKUP_HOST=178.156.141.174
STUDYBOX_BACKUP_USER=deploy
STUDYBOX_BACKUP_REMOTE_DIR=/srv/studybox-backups
STUDYBOX_BACKUP_SSH_KEY=/var/lib/studybox/.ssh/studybox_backup
STUDYBOX_BACKUP_PORT=22
STUDYBOX_BACKUP_RETRY_SECONDS=300
